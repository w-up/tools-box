{
  "name": "web-toolbox",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "lock": "node scripts/with-project-lock.mjs",
    "dev": "pnpm lock --label \"Nuxt dev server\" -- nuxt dev --host --open",
    "build": "pnpm lock --label \"Nuxt build\" -- nuxt build",
    "generate": "pnpm lock --label \"Nuxt generate\" -- nuxt generate",
    "preview": "pnpm lock --label \"Nuxt preview\" -- nuxt preview",
    "test": "pnpm lock --label \"Vitest\" -- vitest run",
    "typecheck": "pnpm lock --label \"Nuxt typecheck\" -- nuxt typecheck",
    "postinstall": "pnpm lock --label \"Nuxt prepare\" -- nuxt prepare",
    "test:concurrency": "node --test scripts/with-project-lock.test.mjs"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/webp": "^1.5.0",
    "jszip": "^3.10.1",
    "nuxt": "^4.4.8",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.7"
  }
}
